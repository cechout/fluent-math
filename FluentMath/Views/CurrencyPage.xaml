<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentMath.Views.CurrencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentMath.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid
        Margin="4"
        ColumnSpacing="2.5"
        RowSpacing="2.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!--  page header  -->
        <!--  (the left margin clears the navigation views hamburger button)  -->
        <Grid
            Grid.Row="0"
            Grid.ColumnSpan="4"
            Height="38"
            Margin="45,0,0,0"
            Background="Transparent">
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="8">

                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Currency" />

                <!--  planned: compact mode toggle  -->
                <!--<Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{ThemeResource SubtleButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE81C;" />
                </Button>-->
            </StackPanel>

            <!--  planned: history flyout  -->
            <!--<Button
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Right"
                Style="{ThemeResource SubtleButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE8A7;" />
            </Button>-->
        </Grid>


        <!--  currency 1 selection  -->
        <!--
            a text only button with a chevron of its own, which opens the hidden combo box under it in
            one click; the combo box places its list over the selected currency itself, which replaces a
            flyout that was pushed into place by a fixed offset and did not always land there
            the grid holds the row at the height of the button, a combo box is taller
        -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="26">

            <Button
                Padding="4,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Click="CurrencyButton1_Click"
                Style="{StaticResource TextButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SelectedCurrency1.DisplayName, Mode=OneWay}" />
                    <FontIcon FontSize="10" Glyph="&#xE70D;" />
                </StackPanel>
            </Button>

            <!--  drives the actual selection; kept invisible, the button above just opens its dropdown  -->
            <ComboBox
                x:Name="CurrencyComboBox1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                DisplayMemberPath="DisplayName"
                IsHitTestVisible="False"
                ItemsSource="{x:Bind ViewModel.AvailableCurrencies}"
                Opacity="0"
                SelectedItem="{x:Bind ViewModel.SelectedCurrency1, Mode=TwoWay}" />
        </Grid>

        <!--  amount being typed  -->
        <!--  (scrolls sideways because a long number must not resize the layout)  -->
        <ScrollViewer
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="4,0,4,0"
            Padding="0"
            Background="Transparent"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <TextBlock
                x:Name="TextBlock_Currency1"
                Margin="0,-12,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{ThemeResource TitleLargeTextBlockStyle}"
                Text="{x:Bind ViewModel.InputText, Mode=OneWay}" />
        </ScrollViewer>


        <!--  currency 2 selection  -->
        <!--  (same picker as currency 1)  -->
        <Grid
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="26">

            <Button
                Padding="4,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Click="CurrencyButton2_Click"
                Style="{StaticResource TextButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SelectedCurrency2.DisplayName, Mode=OneWay}" />
                    <FontIcon FontSize="10" Glyph="&#xE70D;" />
                </StackPanel>
            </Button>

            <!--  drives the actual selection; kept invisible, the button above just opens its dropdown  -->
            <ComboBox
                x:Name="CurrencyComboBox2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                DisplayMemberPath="DisplayName"
                IsHitTestVisible="False"
                ItemsSource="{x:Bind ViewModel.AvailableCurrencies}"
                Opacity="0"
                SelectedItem="{x:Bind ViewModel.SelectedCurrency2, Mode=TwoWay}" />
        </Grid>

        <!--  converted result  -->
        <ScrollViewer
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="4,0,4,0"
            Background="Transparent"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <TextBlock
                x:Name="TextBlock_Currency2"
                Margin="0,-12,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{ThemeResource TitleLargeTextBlockStyle}"
                Text="{x:Bind ViewModel.ResultText, Mode=OneWay}" />
        </ScrollViewer>

        <!--  rate line  -->
        <!--  (e.g. "1 EUR = 1.0842 USD"; updates on every picker change)  -->
        <Border
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="26"
            Margin="0"
            Background="Transparent">
            <TextBlock
                x:Name="TextBlock_CurrencyRate"
                Margin="0,0,7,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.RateText, Mode=OneWay}" />
        </Border>


        <!--  input buttons  -->
        <!--  (grows in when the page is shown, like the pads of the two calculators, see PadEntrance)  -->
        <Grid
            x:Name="Pad"
            Grid.Row="6"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            ColumnSpacing="2.5"
            RowSpacing="2.5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE895;" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.ClearCommand}"
                Style="{StaticResource OperatorButtonStyle}">
                <TextBlock
                    FontSize="16"
                    Style="{ThemeResource BodyLargeTextBlockStyle}"
                    Text="CE" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.BackspaceCommand}"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE750;" />
            </Button>

            <Button
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="7"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="7" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="8"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="8" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="9"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="9" />
            </Button>

            <Button
                Grid.Row="2"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="4"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="4" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="5"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="5" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="6"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="6" />
            </Button>

            <Button
                Grid.Row="3"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="1"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="1" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="2"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="2" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="3"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="3" />
            </Button>

            <Button
                Grid.Row="4"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="."
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="." />
            </Button>
            <Button
                Grid.Row="4"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="0"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="0" />
            </Button>
            <Button
                Grid.Row="4"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.CalculateCommand}"
                Style="{ThemeResource AccentButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="=" />
            </Button>
        </Grid>
    </Grid>
</Page>