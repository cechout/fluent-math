<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentMath.Controls.CalculatorDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentMath.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  two MathPanels  -->
    <!--  the previous calculation over the formula being typed  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" MinHeight="40" />
        </Grid.RowDefinitions>

        <controls:MathPanel
            x:Name="MathDisplay1"
            Grid.Row="0"
            Margin="4,4,4,0"
            Ink="{ThemeResource TextFillColorSecondaryBrush}" />

        <!--  the input line, scrolling sideways once the formula is wider than the display  -->
        <!--
            (a transparent background, so the air beside a short formula takes the tap;
            the panel keeps 4px free at the bottom for the scrollbar)
        -->
        <ScrollViewer
            x:Name="InputScroller"
            Grid.Row="1"
            Margin="4,0,4,2"
            Background="Transparent"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            Tapped="InputDisplay_Tapped"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">

            <controls:MathPanel
                x:Name="MathDisplay2"
                Margin="0,0,0,4"
                Background="Transparent"
                CaretInk="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Ink="{ThemeResource TextFillColorPrimaryBrush}"
                PreviewCaretInk="{ThemeResource TextFillColorSecondaryBrush}"
                PreviewCaretPressedInk="{ThemeResource TextFillColorTertiaryBrush}" />
        </ScrollViewer>
    </Grid>
</UserControl>
