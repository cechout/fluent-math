                Grid.Row="1"
                ColumnSpacing="{StaticResource KeySpacing}"
                RowSpacing="{StaticResource KeySpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  row 0  -->
                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_shift"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE752;" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_shift"
                    Style="{ThemeResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE752;" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_frac"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <!--
                        the stacked fraction it inserts, at the script size of the display
                        (tight line bounds keep the stack inside the key)
                    -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="2,0,2,2"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="x"
                            TextLineBounds="Tight" />
                        <Rectangle
                            Grid.Row="1"
                            Height="1"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="2,2,2,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="y"
                            TextLineBounds="Tight" />
                    </Grid>
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_frac_mixed"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <!--  the mixed fraction: the same stack with the whole part in front  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="x"
                            TextLineBounds="Tight" />
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="2,0,2,2"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Text="y"
                                TextLineBounds="Tight" />
                            <Rectangle
                                Grid.Row="1"
                                Height="1"
                                Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                Grid.Row="2"
                                Margin="2,2,2,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Text="z"
                                TextLineBounds="Tight" />
                        </Grid>
                    </StackPanel>
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_sqrt"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="²√" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_root_n"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="ⁿ√" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_pow_2"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="x²" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_pow_n"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="xⁿ" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_ln"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="ln" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_pow_e"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="eⁿ" />
                </Button>

                <!--  row 1  -->
                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_inv"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="x⁻¹" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_fact"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="x!" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_log"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="log" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_log_b"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="logₙ" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_ans"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Ans" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_percent"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="%" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_paren_open"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="(" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_e"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="e" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_paren_close"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text=")" />
                </Button>
                <!--  (e is the shift of the opening bracket, pi of the closing one)  -->
                <Button
                    Grid.Row="1"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_pi"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="π" />
                </Button>

                <!--  row 2  -->
                <Button
                    Grid.Row="2"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="7"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="7" />
                </Button>
                <Button
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="8"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="8" />
                </Button>
                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="9"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="9" />
                </Button>
                <Button
                    Grid.Row="2"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.BackspaceCommand}"
                    Style="{StaticResource OperatorButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE750;" />
                </Button>
                <Button
                    Grid.Row="2"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ClearCommand}"
                    Style="{StaticResource OperatorButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="AC" />
                </Button>

                <!--  row 3  -->
                <Button
                    Grid.Row="3"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="4"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="4" />
                </Button>
                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="5"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="5" />
                </Button>
                <Button
                    Grid.Row="3"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="6"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="6" />
                </Button>
                <Button
                    Grid.Row="3"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="*"
                    Style="{StaticResource OperatorButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE947;" />
                </Button>
                <Button
                    Grid.Row="3"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="/"
                    Style="{StaticResource OperatorButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE94A;" />
                </Button>

                <!--  row 4  -->
                <Button
                    Grid.Row="4"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="1"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="1" />
                </Button>
                <Button
                    Grid.Row="4"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="2"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="2" />
                </Button>
                <Button
                    Grid.Row="4"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="3"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="3" />
                </Button>
                <Button
                    Grid.Row="4"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="+"
                    Style="{StaticResource OperatorButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE948;" />
                </Button>
                <Button
                    Grid.Row="4"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="-"
                    Style="{StaticResource OperatorButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE949;" />
                </Button>

                <!--  row 5  -->
                <Button
                    Grid.Row="5"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="0"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="0" />
                </Button>
                <Button
                    Grid.Row="5"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="."
                    Style="{StaticResource NumberPadButtonStyle}">
                    <!--  (always types a dot; the label follows the decimal mark of the display)  -->
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="{x:Bind ViewModel.DecimalMarkLabel, Mode=OneWay}" />
                </Button>
                <Button
                    Grid.Row="5"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_exp"
                    Style="{StaticResource NumberPadButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <!--  (the sign the display prints, not the asterisk it is typed as)  -->
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="×10ⁿ" />
                </Button>
                <!--  x, the variable of the calculus panel  -->
                <Button
                    Grid.Row="5"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_x"
                    Style="{StaticResource NumberPadButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="x" />
                </Button>
                <Button
                    Grid.Row="5"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ToggleAnswerFormCommand}"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE8AB;" />
                </Button>
                <!--  improper ⇔ mixed fraction, the a b/c ⇔ d/c of a Casio  -->
                <Button
                    Grid.Row="5"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_frac_swap"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="ab/c" />
                </Button>
                <Button
                    Grid.Row="5"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.CalculateCommand}"
                    Style="{ThemeResource AccentButtonStyle}">
                    <FontIcon
                        FontSize="14"
                        FontWeight="Bold"
                        Glyph="&#xE94E;" />
                </Button>
            </Grid>
        </Grid>

    </Grid>
</Page>
