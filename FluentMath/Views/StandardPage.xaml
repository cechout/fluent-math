<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentMath.Views.StandardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentMath.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentMath.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <!--  the scientific page without its panel bar, shift layer and splitter: header, display, keypad  -->
    <Grid Margin="4,4,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4*" MinHeight="96" />
            <RowDefinition Height="5*" MinHeight="220" />
        </Grid.RowDefinitions>


        <!--  page header  -->
        <!--  (the left margin clears the navigation views hamburger button)  -->
        <Grid
            Grid.Row="0"
            Height="38"
            Margin="45,0,0,0"
            Background="Transparent">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Standard" />

            <!--  history and memory  -->
            <!--  (the same two keys as on the scientific page, so the two calculators read alike)  -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_history"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE81C;" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_memory"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE8F1;" />
                </Button>
            </StackPanel>
        </Grid>


        <!--  calculator display  -->
        <!--  (both lines are one CalculatorDisplay, the caret bar is the Auto row under it)  -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:CalculatorDisplay Grid.Row="0" ViewModel="{x:Bind ViewModel}" />

            <!--  caret bar  -->
            <!--
                only the arrow keys; the fraction, the root and the square open slots, and an arrow is
                the way out of one besides a click into the display
                nothing on this pad reads the angle unit, so its selector stays on the scientific page
            -->
            <StackPanel
                Grid.Row="1"
                Height="{StaticResource BarKeyHeight}"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="{StaticResource KeySpacing}">

                <Button
                    Height="{StaticResource BarKeyHeight}"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_nav_down"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE70D;" />
                </Button>
                <Button
                    Height="{StaticResource BarKeyHeight}"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_nav_up"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE70E;" />
                </Button>
                <Button
                    Height="{StaticResource BarKeyHeight}"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_nav_left"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Button>
                <Button
                    Height="{StaticResource BarKeyHeight}"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_nav_right"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                </Button>
            </StackPanel>
        </Grid>


        <!--  keypad  -->
        <!--
            the keys of a pocket calculator, bound to the same commands as the scientific pad
            the whole pad grows in when the page is shown, see PadEntrance
        -->
        <Grid
            x:Name="Pad"
            Grid.Row="2"
            Margin="0,4,0,0"
            ColumnSpacing="{StaticResource KeySpacing}"
            RowSpacing="{StaticResource KeySpacing}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  row 0  -->
            <Button
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_paren_open"
                Style="{StaticResource OperatorButtonStyle}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="(" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_paren_close"
                Style="{StaticResource OperatorButtonStyle}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text=")" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.BackspaceCommand}"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE750;" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.ClearCommand}"
                Style="{StaticResource OperatorButtonStyle}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="AC" />
            </Button>

            <!--  row 1  -->
            <Button
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_frac"
                Style="{StaticResource OperatorButtonStyle}">
                <!--  the stacked fraction it inserts, drawn the same way as on the scientific pad  -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="2,0,2,2"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Text="x"
                        TextLineBounds="Tight" />
                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="2,2,2,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Text="y"
                        TextLineBounds="Tight" />
                </Grid>
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_sqrt"
                Style="{StaticResource OperatorButtonStyle}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="²√" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_pow_2"
                Style="{StaticResource OperatorButtonStyle}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="x²" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="/"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE94A;" />
            </Button>

            <!--  row 2  -->
            <Button
                Grid.Row="2"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="7"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="7" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="8"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="8" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="9"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="9" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="*"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE947;" />
            </Button>

            <!--  row 3  -->
            <Button
                Grid.Row="3"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="4"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="4" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="5"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="5" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="6"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="6" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="-"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE949;" />
            </Button>

            <!--  row 4  -->
            <Button
                Grid.Row="4"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="1"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="1" />
            </Button>
            <Button
                Grid.Row="4"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="2"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="2" />
            </Button>
            <Button
                Grid.Row="4"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="3"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="3" />
            </Button>
            <Button
                Grid.Row="4"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="+"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE948;" />
            </Button>

            <!--  row 5  -->
            <Button
                Grid.Row="5"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="0"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="0" />
            </Button>
            <Button
                Grid.Row="5"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="."
                Style="{StaticResource NumberPadButtonStyle}">
                <!--  the key always types a dot; the label follows the decimal mark the display draws it as  -->
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="{x:Bind ViewModel.DecimalMarkLabel, Mode=OneWay}" />
            </Button>
            <Button
                Grid.Row="5"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_exp"
                Style="{StaticResource NumberPadButtonStyle}">
                <!--  the multiplication sign is the one the display prints, not the asterisk it is typed as  -->
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="×10ⁿ" />
            </Button>
            <Button
                Grid.Row="5"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.CalculateCommand}"
                Style="{ThemeResource AccentButtonStyle}">
                <FontIcon
                    FontSize="14"
                    FontWeight="Bold"
                    Glyph="&#xE94E;" />
            </Button>
        </Grid>

    </Grid>
</Page>
