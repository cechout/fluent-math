<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentMath.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid Margin="4,4,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  page header  -->
        <!--  (the left margin clears the navigation views hamburger button)  -->
        <Grid
            Grid.Row="0"
            Height="38"
            Margin="45,0,0,0"
            Background="Transparent">

            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="1000"
                Margin="12,12,12,16"
                HorizontalAlignment="Stretch"
                Spacing="4">

                <TextBlock
                    Margin="1,8,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Appearance" />

                <!--  (the selection is applied through MainWindow and is not persisted across restarts)  -->
                <controls:SettingsCard
                    Description="Select your preferred color mode for the calculator"
                    Header="App Theme"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                    <ComboBox
                        x:Name="ThemeComboBox"
                        Width="150"
                        SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="System Default" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </controls:SettingsCard>

                <TextBlock
                    Margin="1,24,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Calculator" />

                <!--
                    the calculator setup, held by App.Settings for the session and read by the calculator
                    pages whenever they come back into view; every combo box lists its options in the
                    order of the values they stand for, which the code-behind relies on
                -->
                <controls:SettingsCard
                    Description="The unit sin, cos and tan read an angle in"
                    Header="Angle unit"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE7AD;}">
                    <ComboBox
                        x:Name="AngleUnitComboBox"
                        Width="150"
                        SelectionChanged="CalculatorComboBox_SelectionChanged">
                        <ComboBoxItem Content="Degrees" />
                        <ComboBoxItem Content="Radians" />
                        <ComboBoxItem Content="Gradians" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Whether a result opens in its exact form, a fraction, a root or π, or as its decimal; S⇔D switches between them"
                    Header="Result form"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8AB;}">
                    <ComboBox
                        x:Name="ResultFormComboBox"
                        Width="150"
                        SelectionChanged="CalculatorComboBox_SelectionChanged">
                        <ComboBoxItem Content="Exact first" />
                        <ComboBoxItem Content="Decimal first" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Which of the two fractions a result shows first; SHIFT S⇔D swaps them"
                    Header="Fraction form"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE94A;}">
                    <ComboBox
                        x:Name="FractionFormComboBox"
                        Width="150"
                        SelectionChanged="CalculatorComboBox_SelectionChanged">
                        <ComboBoxItem Content="Improper" />
                        <ComboBoxItem Content="Mixed" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="S⇔D shows a fraction as a decimal with a bar over its period on the way to the decimal, 2.3 with a bar for 7/3"
                    Header="Recurring decimals"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8EE;}">
                    <ToggleSwitch x:Name="RecurringToggle" Toggled="CalculatorToggle_Toggled" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Norm 1 and Norm 2 write a power of ten below 0.01 and 1e-9, Fix a set number of decimals, Sci a set number of significant digits"
                    Header="Number format"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8EF;}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            x:Name="NotationComboBox"
                            Width="110"
                            SelectionChanged="CalculatorComboBox_SelectionChanged">
                            <ComboBoxItem Content="Norm 1" />
                            <ComboBoxItem Content="Norm 2" />
                            <ComboBoxItem Content="Fix" />
                            <ComboBoxItem Content="Sci" />
                        </ComboBox>
                        <ComboBox
                            x:Name="DigitsComboBox"
                            Width="80"
                            SelectionChanged="CalculatorComboBox_SelectionChanged">
                            <ComboBoxItem Content="0" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="6" />
                            <ComboBoxItem Content="7" />
                            <ComboBoxItem Content="8" />
                            <ComboBoxItem Content="9" />
                        </ComboBox>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="The ENG keys write a result as 1.234k instead of 1.234×10³"
                    Header="Decimal prefixes"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8C1;}">
                    <ToggleSwitch x:Name="PrefixesToggle" Toggled="CalculatorToggle_Toggled" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="The mark between the whole part and the decimals; with a comma, two arguments are separated by a semicolon"
                    Header="Decimal mark"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE774;}">
                    <ComboBox
                        x:Name="DecimalMarkComboBox"
                        Width="150"
                        SelectionChanged="CalculatorComboBox_SelectionChanged">
                        <ComboBoxItem Content="Windows region" />
                        <ComboBoxItem Content="Dot" />
                        <ComboBoxItem Content="Comma" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="A thin gap every three digits, in the formula and in the result"
                    Header="Digit grouping"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8FD;}">
                    <ToggleSwitch x:Name="GroupDigitsToggle" Toggled="CalculatorToggle_Toggled" />
                </controls:SettingsCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>