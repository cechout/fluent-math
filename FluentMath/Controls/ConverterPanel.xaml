<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentMath.Controls.ConverterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  (row floors in the code-behind)  -->
    <Grid
        x:Name="RootGrid"
        Margin="4"
        ColumnSpacing="2.5"
        RowSpacing="2.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="PickerRow1" Height="Auto" />
            <RowDefinition x:Name="AmountRow1" Height="*" />
            <RowDefinition x:Name="PickerRow2" Height="Auto" />
            <RowDefinition x:Name="AmountRow2" Height="*" />
            <RowDefinition x:Name="RateRow" Height="Auto" />
            <RowDefinition x:Name="PadRow" Height="4*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!--  page header  -->
        <!--  (the left margin clears the navigation views hamburger button)  -->
        <Grid
            x:Name="Header"
            Grid.Row="0"
            Grid.ColumnSpan="4"
            Height="38"
            Margin="45,0,0,0"
            Background="Transparent">
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="8">

                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind Title}" />

                <!--  compact mode toggle  -->
                <!--  (the Windows Calculator keep on top glyph)  -->
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="CompactButton_Click"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xEE49;" />
                </Button>
            </StackPanel>

            <!--  planned: history flyout  -->
            <!--<Button
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Right"
                Style="{ThemeResource SubtleButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE8A7;" />
            </Button>-->
        </Grid>


        <!--  unit 1 selection  -->
        <!--
            a text button that opens the hidden combo box under it, which lays its list over the selection
            (the grid holds the row at the height of the button; a combo box is taller)
        -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="26">

            <Button
                Margin="0,-2.5,0,0"
                Padding="4,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Click="UnitButton1_Click"
                Style="{StaticResource TextButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.TopUnit.DisplayName, Mode=OneWay}" />
                    <FontIcon FontSize="10" Glyph="&#xE70D;" />
                </StackPanel>
            </Button>

            <!--  (invisible; does the selecting, the button only opens it)  -->
            <ComboBox
                x:Name="UnitComboBox1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                DisplayMemberPath="DisplayName"
                IsHitTestVisible="False"
                ItemsSource="{x:Bind ViewModel.Units, Mode=OneWay}"
                Opacity="0"
                SelectedItem="{x:Bind ViewModel.TopUnit, Mode=TwoWay}" />
        </Grid>

        <!--  amount 1  -->
        <!--
            (scrolls sideways, so a long number never resizes the layout; the wheel too, with vertical off)
            a tap makes it the line that takes the input, which is one weight heavier
            the bottom margin reaches over the row gap and 4 into the empty top of the row below, out of
            the way of the number, and the padding gives it back, so the number stays where it was
        -->
        <ScrollViewer
            x:Name="AmountScroller1"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="4,0,4,-6.5"
            Padding="0,0,0,6.5"
            Background="Transparent"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            Tapped="Amount1_Tapped"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <TextBlock
                x:Name="TextBlock_Amount1"
                Margin="0,-12,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontWeight="{x:Bind WeightOf(ViewModel.IsTopActive), Mode=OneWay}"
                SizeChanged="Amount1_SizeChanged"
                Style="{ThemeResource TitleLargeTextBlockStyle}"
                Text="{x:Bind ViewModel.TopText, Mode=OneWay}" />
        </ScrollViewer>


        <!--  unit 2 selection  -->
        <!--  (same picker as unit 1)  -->
        <Grid
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="26">

            <Button
                Padding="4,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Click="UnitButton2_Click"
                Style="{StaticResource TextButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.BottomUnit.DisplayName, Mode=OneWay}" />
                    <FontIcon FontSize="10" Glyph="&#xE70D;" />
                </StackPanel>
            </Button>

            <!--  (invisible; does the selecting, the button only opens it)  -->
            <ComboBox
                x:Name="UnitComboBox2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                DisplayMemberPath="DisplayName"
                IsHitTestVisible="False"
                ItemsSource="{x:Bind ViewModel.Units, Mode=OneWay}"
                Opacity="0"
                SelectedItem="{x:Bind ViewModel.BottomUnit, Mode=TwoWay}" />
        </Grid>

        <!--  amount 2  -->
        <!--  (same line as amount 1)  -->
        <ScrollViewer
            x:Name="AmountScroller2"
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="4,0,4,-6.5"
            Padding="0,0,0,6.5"
            Background="Transparent"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            Tapped="Amount2_Tapped"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <TextBlock
                x:Name="TextBlock_Amount2"
                Margin="0,-12,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontWeight="{x:Bind WeightOf(ViewModel.IsBottomActive), Mode=OneWay}"
                SizeChanged="Amount2_SizeChanged"
                Style="{ThemeResource TitleLargeTextBlockStyle}"
                Text="{x:Bind ViewModel.BottomText, Mode=OneWay}" />
        </ScrollViewer>

        <!--  rate line  -->
        <!--  (e.g. "1 EUR = 1.0842 USD"; updates on every picker change)  -->
        <Border
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Height="26"
            Margin="0"
            Background="Transparent">
            <Grid>
                <!--  the day the rates are for; (empty on a converter whose units never change)  -->
                <TextBlock
                    Margin="7,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.DateText, Mode=OneWay}" />

                <TextBlock
                    x:Name="TextBlock_Rate"
                    Margin="0,0,7,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.RateText, Mode=OneWay}" />
            </Grid>
        </Border>


        <!--  input buttons  -->
        <!--
            (grows in through PadEntrance)
            every key converts at once, so there is no equals key; its slot stays empty, and so does
            the refresh slot of a converter without a refresh
        -->
        <Grid
            x:Name="Pad"
            Grid.Row="6"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            ColumnSpacing="2.5"
            RowSpacing="2.5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.CanRefresh}">
                <FontIcon FontSize="16" Glyph="&#xE895;" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.ClearCommand}"
                Style="{StaticResource OperatorButtonStyle}">
                <TextBlock
                    FontSize="16"
                    Style="{ThemeResource BodyLargeTextBlockStyle}"
                    Text="CE" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.BackspaceCommand}"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE750;" />
            </Button>

            <Button
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="7"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="7" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="8"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="8" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="9"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="9" />
            </Button>

            <Button
                Grid.Row="2"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="4"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="4" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="5"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="5" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="6"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="6" />
            </Button>

            <Button
                Grid.Row="3"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="1"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="1" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="2"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="2" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="3"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="3" />
            </Button>

            <Button
                Grid.Row="4"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="."
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="{x:Bind ViewModel.DecimalMarkLabel, Mode=OneWay}" />
            </Button>
            <Button
                Grid.Row="4"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="0"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="0" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
