<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentMath.Views.ScientificPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentMath.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentMath.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <!--
        four rows: header, display, divider, pad; the pad is the panel bar over the keypad
        the display has a fixed height only the splitter changes, the pad takes the rest
        (row floors in the code-behind; a window too short for the pad pushes the splitter up)
    -->
    <Grid x:Name="RootGrid" Margin="4,4,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="DisplayRow" Height="150" />
            <RowDefinition x:Name="DividerRow" Height="Auto" />
            <RowDefinition x:Name="PadRow" Height="*" />
        </Grid.RowDefinitions>


        <!--  page header  -->
        <!--  (the left margin clears the navigation views hamburger button)  -->
        <Grid
            x:Name="Header"
            Grid.Row="0"
            Height="38"
            Margin="45,0,0,0"
            Background="Transparent">
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="8">

                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Scientific" />

                <!--  compact mode toggle  -->
                <!--  (the Windows Calculator keep on top glyph)  -->
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Click="CompactButton_Click"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xEE49;" />
                </Button>
            </StackPanel>

            <!--  history and memory  -->
            <!--
                disabled until the history list and the variable store exist
                (memory is the library glyph; it opens a store of formulas, not the one M register)
            -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_history"
                    IsEnabled="False"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE81C;" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_memory"
                    IsEnabled="False"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE8F1;" />
                </Button>
            </StackPanel>
        </Grid>


        <!--  calculator display  -->
        <!--
            (both lines are one CalculatorDisplay; the caret bar is the Auto row under it,
            so it keeps its height while the splitter resizes the block)
        -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:CalculatorDisplay
                x:Name="Display"
                Grid.Row="0"
                ViewModel="{x:Bind ViewModel}" />

            <!--  caret bar  -->
            <!--
                the angle unit and the arrow keys, the two things that switch rather than write
                (fixed size keys at opposite edges, so neither group reflows; flat, since a raised fill
                marks a key that writes)
            -->
            <Grid Grid.Row="1" Height="{StaticResource BarKeyHeight}">

                <Button
                    Height="{StaticResource BarKeyHeight}"
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_angle_cycle"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.AngleModeLabel, Mode=OneWay}" />
                </Button>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="{StaticResource KeySpacing}">

                    <Button
                        Height="{StaticResource BarKeyHeight}"
                        Command="{x:Bind ViewModel.InputCommand}"
                        CommandParameter="cmd_nav_down"
                        Style="{StaticResource SubtleBarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE70D;" />
                    </Button>
                    <Button
                        Height="{StaticResource BarKeyHeight}"
                        Command="{x:Bind ViewModel.InputCommand}"
                        CommandParameter="cmd_nav_up"
                        Style="{StaticResource SubtleBarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE70E;" />
                    </Button>
                    <Button
                        Height="{StaticResource BarKeyHeight}"
                        Command="{x:Bind ViewModel.InputCommand}"
                        CommandParameter="cmd_nav_left"
                        Style="{StaticResource SubtleBarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        Height="{StaticResource BarKeyHeight}"
                        Command="{x:Bind ViewModel.InputCommand}"
                        CommandParameter="cmd_nav_right"
                        Style="{StaticResource SubtleBarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE76C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>


        <!--  divider  -->
        <!--  (the negative sides reach the window edge; centered in the 9px band of the splitter)  -->
        <Rectangle
            x:Name="DividerLine"
            Grid.Row="2"
            Height="1"
            Margin="-4,4,-4,4"
            HorizontalAlignment="Stretch"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
            RadiusX="0.5"
            RadiusY="0.5" />


        <!--  divider grab  -->
        <!--
            over the divider row, transparent until the pointer reaches it
            (PreviousAndNext trades the display row against the pad row; their MinHeight is how far it goes)
        -->
        <toolkit:GridSplitter
            x:Name="DisplaySplitter"
            Grid.Row="2"
            Height="9"
            Margin="-4,0,-4,0"
            Padding="0"
            VerticalAlignment="Top"
            IsThumbVisible="False"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows" />


        <!--  pad  -->
        <!--  (the panel bar over the keypad; grows in through PadEntrance)  -->
        <Grid x:Name="Pad" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  panel bar  -->
            <!--
                a function family gets a panel here rather than a key below; the keypad holds what a
                calculator prints on a key, this bar what one hides behind a menu
                (scrolls sideways without a scrollbar; no window width fits every button)
            -->
            <ScrollViewer
                x:Name="PanelScroller"
                Grid.Row="0"
                Margin="0,0,0,4"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Auto"
                Loaded="PanelScroller_Loaded"
                SizeChanged="PanelScroller_SizeChanged"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ViewChanged="PanelScroller_ViewChanged">
                <StackPanel
                    x:Name="PanelStrip"
                    Orientation="Horizontal"
                    Spacing="4">

                    <Button Height="{StaticResource BarKeyHeight}" Style="{StaticResource SubtleBarButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Trigonometry" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="10"
                                Glyph="&#xE70D;" />
                        </StackPanel>

                        <Button.Flyout>
                            <!--
                                (Bottom drops the panel over the keypad; unconstrained, it may hang out
                                of the window rather than be squeezed to one key per row)
                            -->
                            <Flyout
                                x:Name="TrigonometryFlyout"
                                AreOpenCloseAnimationsEnabled="False"
                                Closed="TrigonometryFlyout_Closed"
                                Placement="Bottom"
                                ShouldConstrainToRootBounds="False">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="{StaticResource PanelFlyoutOffset}" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <!--  two latches, and four layers of the same six keys of which one is visible  -->
                                <Grid ColumnSpacing="{StaticResource KeySpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  (a latch is two buttons in one cell, like the shift key)  -->
                                    <Grid Grid.Column="0" RowSpacing="{StaticResource KeySpacing}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_trig_inv"
                                            Style="{StaticResource OperatorButtonStyle}"
                                            Visibility="{x:Bind ViewModel.IsTrigInverseUnlatched, Mode=OneWay}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Inv" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_trig_inv"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Visibility="{x:Bind ViewModel.IsTrigInverseLatched, Mode=OneWay}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Inv" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_trig_hyp"
                                            Style="{StaticResource OperatorButtonStyle}"
                                            Visibility="{x:Bind ViewModel.IsTrigHyperbolicUnlatched, Mode=OneWay}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="hyp" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_trig_hyp"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Visibility="{x:Bind ViewModel.IsTrigHyperbolicLatched, Mode=OneWay}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="hyp" />
                                        </Button>
                                    </Grid>

                                    <!--  plain  -->
                                    <Grid
                                        Grid.Column="1"
                                        ColumnSpacing="{StaticResource KeySpacing}"
                                        RowSpacing="{StaticResource KeySpacing}"
                                        Visibility="{x:Bind ViewModel.ShowTrigPlain, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_sin"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sin" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_cos"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cos" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_tan"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tan" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_sec"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sec" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_csc"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csc" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_cot"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cot" />
                                        </Button>
                                    </Grid>

                                    <!--  inverse  -->
                                    <Grid
                                        Grid.Column="1"
                                        ColumnSpacing="{StaticResource KeySpacing}"
                                        RowSpacing="{StaticResource KeySpacing}"
                                        Visibility="{x:Bind ViewModel.ShowTrigInverse, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_asin"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sin⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acos"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cos⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_atan"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tan⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_asec"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sec⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acsc"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csc⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acot"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cot⁻¹" />
                                        </Button>
                                    </Grid>

                                    <!--  hyperbolic  -->
                                    <Grid
                                        Grid.Column="1"
                                        ColumnSpacing="{StaticResource KeySpacing}"
                                        RowSpacing="{StaticResource KeySpacing}"
                                        Visibility="{x:Bind ViewModel.ShowTrigHyperbolic, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_sinh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sinh" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_cosh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cosh" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_tanh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tanh" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_sech"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sech" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_csch"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csch" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_coth"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="coth" />
                                        </Button>
                                    </Grid>

                                    <!--  inverse hyperbolic  -->
                                    <Grid
                                        Grid.Column="1"
                                        ColumnSpacing="{StaticResource KeySpacing}"
                                        RowSpacing="{StaticResource KeySpacing}"
                                        Visibility="{x:Bind ViewModel.ShowTrigInverseHyperbolic, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_asinh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sinh⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acosh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cosh⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_atanh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tanh⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_asech"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sech⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acsch"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csch⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acoth"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="coth⁻¹" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Height="{StaticResource BarKeyHeight}" Style="{StaticResource SubtleBarButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Function" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="10"
                                Glyph="&#xE70D;" />
                        </StackPanel>

                        <Button.Flyout>
                            <Flyout
                                x:Name="FunctionFlyout"
                                AreOpenCloseAnimationsEnabled="False"
                                Placement="Bottom"
                                ShouldConstrainToRootBounds="False">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="{StaticResource PanelFlyoutOffset}" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <!--  one layer, no latch: none of these five comes in a family  -->
                                <Grid ColumnSpacing="{StaticResource KeySpacing}" RowSpacing="{StaticResource KeySpacing}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_abs"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="|x|" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_floor"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="⌊x⌋" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Width="{StaticResource PanelKeyWidth}"
