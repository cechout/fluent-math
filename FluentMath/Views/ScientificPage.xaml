                these two carry no look of their own. The empty host is what the faded copy of the strip
                is drawn over, and the rectangle is nothing but the gradient that says how much of each
                column survives; the code-behind reads the alpha of the second as the alpha of the first
                all three are the same size and sit in the same place, which is what lets the copy line
                up with the original; the stops are opaque here and the code-behind opens the side that
                has somewhere left to scroll
                three stops per side: the strip is gone outright for the width of the chevron, so it
                ends where the button begins rather than passing under it, and the ramp back to full
                runs from there
            -->
            <Grid
                x:Name="PanelStripFade"
                Grid.Row="0"
                Height="{StaticResource BarKeyHeight}"
                Margin="0,0,0,4"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False" />

            <Rectangle
                x:Name="PanelStripMask"
                Grid.Row="0"
                Height="{StaticResource BarKeyHeight}"
                Margin="0,0,0,4"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop x:Name="PanelFadeLeftOuter" Offset="0.0" Color="#FFFFFFFF" />
                        <GradientStop x:Name="PanelFadeLeftCut" Offset="0.0" Color="#FFFFFFFF" />
                        <GradientStop x:Name="PanelFadeLeftInner" Offset="0.0" Color="#FFFFFFFF" />
                        <GradientStop x:Name="PanelFadeRightInner" Offset="1.0" Color="#FFFFFFFF" />
                        <GradientStop x:Name="PanelFadeRightCut" Offset="1.0" Color="#FFFFFFFF" />
                        <GradientStop x:Name="PanelFadeRightOuter" Offset="1.0" Color="#FFFFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>


            <!--  panel bar chevrons  -->
            <!--
                a chevron is over the strip rather than beside it, so the category buttons still get the
                full width whenever nothing overflows, and it appears only while that side has somewhere
                left to go
                both sit in the panel bar row of the pad instead of in the bar itself, which keeps the
                flyouts one level shallower than wrapping the strip would; the bottom margin is the one
                the bar carries, so a chevron lands on the strip and not on the gap under it
            -->
            <Button
                x:Name="PanelScrollLeft"
                Grid.Row="0"
                Width="24"
                Height="{StaticResource BarKeyHeight}"
                Margin="0,0,0,4"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Click="PanelScrollLeft_Click"
                Style="{StaticResource SubtleBarButtonStyle}"
                Visibility="Collapsed">
                <FontIcon FontSize="12" Glyph="&#xE76B;" />
            </Button>

            <Button
                x:Name="PanelScrollRight"
                Grid.Row="0"
                Width="24"
                Height="{StaticResource BarKeyHeight}"
                Margin="0,0,0,4"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="PanelScrollRight_Click"
                Style="{StaticResource SubtleBarButtonStyle}"
                Visibility="Collapsed">
                <FontIcon FontSize="12" Glyph="&#xE76C;" />
            </Button>


            <!--  keypad  -->
            <!--
                every key binds to the same InputCommand and identifies itself through its
                CommandParameter, so the page carries no input logic at all
                A shiftable key is two buttons in the same cell whose Visibility is driven by
                NormalVisibility / ShiftVisibility, one of which is always collapsed
            -->
            <Grid
                Grid.Row="1"
                ColumnSpacing="{StaticResource KeySpacing}"
                RowSpacing="{StaticResource KeySpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  row 0  -->
                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_shift"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE752;" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_shift"
                    Style="{ThemeResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE752;" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_frac"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <!--
                        the key is drawn as the stacked fraction it inserts instead of being written on
                        one line, so it shows the shape that ends up on the display
                        both halves sit at the script size the display sets a numerator in, and tight
                        line bounds drop the leading around them, which is what keeps the stack inside a
                        key; the bar reaches past them on either side the way the display draws it
                    -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="2,0,2,2"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="x"
                            TextLineBounds="Tight" />
                        <Rectangle
                            Grid.Row="1"
                            Height="1"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="2,2,2,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="y"
                            TextLineBounds="Tight" />
                    </Grid>
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_frac_mixed"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <!--  the same stack with the whole part in front of it, which is the shape a mixed fraction has  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="x"
                            TextLineBounds="Tight" />
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="2,0,2,2"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Text="y"
                                TextLineBounds="Tight" />
                            <Rectangle
                                Grid.Row="1"
                                Height="1"
                                Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                Grid.Row="2"
                                Margin="2,2,2,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Text="z"
                                TextLineBounds="Tight" />
                        </Grid>
                    </StackPanel>
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_sqrt"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="²√" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_root_n"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="ⁿ√" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_pow_2"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="x²" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_pow_n"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="xⁿ" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_ln"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="ln" />
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_pow_e"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="eⁿ" />
                </Button>

                <!--  row 1  -->
                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_inv"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="x⁻¹" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_fact"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="x!" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_log"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="log" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_log_b"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="logₙ" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_ans"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Ans" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_percent"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="%" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_paren_open"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="(" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_e"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="e" />
                </Button>
                <Button
                    Grid.Row="1"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_paren_close"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text=")" />
                </Button>
                <!--  the two constants sit on the two brackets, e over the one that opens and pi over the one that closes  -->
                <Button
                    Grid.Row="1"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_pi"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="π" />
                </Button>

                <!--  row 2  -->
                <Button
                    Grid.Row="2"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="7"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="7" />
                </Button>
                <Button
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="8"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="8" />
                </Button>
                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="9"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="9" />
                </Button>
                <Button
                    Grid.Row="2"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.BackspaceCommand}"
                    Style="{StaticResource OperatorButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE750;" />
                </Button>
                <Button
                    Grid.Row="2"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ClearCommand}"
                    Style="{StaticResource OperatorButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="AC" />
                </Button>

                <!--  row 3  -->
                <Button
                    Grid.Row="3"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="4"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="4" />
                </Button>
                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="5"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="5" />
                </Button>
                <Button
                    Grid.Row="3"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="6"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="6" />
                </Button>
                <Button
                    Grid.Row="3"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="*"
                    Style="{StaticResource OperatorButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE947;" />
                </Button>
                <Button
                    Grid.Row="3"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="/"
                    Style="{StaticResource OperatorButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE94A;" />
                </Button>

                <!--  row 4  -->
                <Button
                    Grid.Row="4"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="1"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="1" />
                </Button>
                <Button
                    Grid.Row="4"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="2"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="2" />
                </Button>
                <Button
                    Grid.Row="4"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="3"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="3" />
                </Button>
                <Button
                    Grid.Row="4"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="+"
                    Style="{StaticResource OperatorButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE948;" />
                </Button>
                <Button
                    Grid.Row="4"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="-"
                    Style="{StaticResource OperatorButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE949;" />
                </Button>

                <!--  row 5  -->
                <Button
                    Grid.Row="5"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="0"
                    Style="{StaticResource NumberPadButtonStyle}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="0" />
                </Button>
                <Button
                    Grid.Row="5"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="."
                    Style="{StaticResource NumberPadButtonStyle}">
                    <!--  the key always types a dot; the label follows the decimal mark the display draws it as  -->
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="{x:Bind ViewModel.DecimalMarkLabel, Mode=OneWay}" />
                </Button>
                <Button
                    Grid.Row="5"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_exp"
                    Style="{StaticResource NumberPadButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <!--  the multiplication sign is the one the display prints, not the asterisk it is typed as  -->
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="×10ⁿ" />
                </Button>
                <!--  x, the variable of the calculus panel, on the one key of the pad that had no shift  -->
                <Button
                    Grid.Row="5"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_x"
                    Style="{StaticResource NumberPadButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="x" />
                </Button>
                <Button
                    Grid.Row="5"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.ToggleAnswerFormCommand}"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE8AB;" />
                </Button>
                <!--  the shift of S⇔D swaps a fraction between improper and mixed, the a b/c ⇔ d/c of a Casio  -->
                <Button
                    Grid.Row="5"
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_frac_swap"
                    Style="{StaticResource OperatorButtonStyle}"
                    Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="ab/c" />
                </Button>
                <Button
                    Grid.Row="5"
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.CalculateCommand}"
                    Style="{ThemeResource AccentButtonStyle}">
                    <FontIcon
                        FontSize="14"
                        FontWeight="Bold"
                        Glyph="&#xE94E;" />
                </Button>
            </Grid>
        </Grid>

    </Grid>
</Page>
