<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Calculator_WinUI.Views.StandardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Calculator_WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Calculator_WinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="4,4,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6*" />
        </Grid.RowDefinitions>


        <!--  page header  -->
        <!--  (the left margin clears the navigation views hamburger button)  -->
        <Grid
            Grid.Row="0"
            Height="38"
            Margin="45,0,0,0"
            Background="Transparent">
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="8">

                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Standard" />

                <!--  planned: compact mode toggle  -->
                <!--<Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{ThemeResource SubtleButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE81C;" />
                </Button>-->
            </StackPanel>

            <!--  planned: history flyout  -->
            <!--<Button
                Width="32"
                Height="32"
                Padding="0"
                HorizontalAlignment="Right"
                Style="{ThemeResource SubtleButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE8A7;" />
            </Button>-->
        </Grid>


        <!--  calculator display  -->
        <!--
            both lines are drawn by a MathPanel out of ordinary XAML elements
            top is the previous calculation, bottom is what is being typed; content is pushed in from
            the code-behind, since neither line can be bound to
        -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="3*" MinHeight="40" />
            </Grid.RowDefinitions>

            <controls:MathPanel
                x:Name="MathDisplay1"
                Grid.Row="0"
                Margin="4,0,4,0"
                Ink="{ThemeResource TextFillColorSecondaryBrush}" />

            <!--  the input line scrolls sideways once the formula is wider than the display  -->
            <!--
                the tap is taken here rather than on the panel, and the transparent background is what
                makes that work: the formula is only as wide as it is, and aiming at the air beside it
                is how a short one is clicked into at all
            -->
            <ScrollViewer
                x:Name="InputScroller"
                Grid.Row="1"
                Margin="4,0,4,8"
                Background="Transparent"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                Tapped="InputDisplay_Tapped"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">

                <controls:MathPanel
                    x:Name="MathDisplay2"
                    Background="Transparent"
                    CaretInk="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Ink="{ThemeResource TextFillColorPrimaryBrush}" />
            </ScrollViewer>
        </Grid>


        <!--  caret bar  -->
        <!--
            the arrow keys move the caret rather than write anything, so they sit with the display
            instead of on the pad; the angle unit rides along because it is the other thing that is a
            mode and not an input, and its button shows the unit it is currently in
            the two groups are pushed to opposite edges and the keys are a fixed size rather than a
            share of the width, so neither group reflows as the window is resized
            the keys are flat, like the panel buttons below them, and both bars run at the same key
            height: everything above the divider is read from or switched, and the raised fill below
            it is what marks a key that writes something
        -->
        <Grid
            Grid.Row="2"
            Height="{StaticResource BarKeyHeight}"
            Margin="0,0,0,4">

            <Button
                Height="{StaticResource BarKeyHeight}"
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_angle_cycle"
                Style="{StaticResource SubtleBarButtonStyle}">
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.AngleModeLabel, Mode=OneWay}" />
            </Button>

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="2.5">
                <Button
                    Height="{StaticResource BarKeyHeight}"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_nav_left"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Button>
                <Button
                    Height="{StaticResource BarKeyHeight}"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_nav_down"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE70D;" />
                </Button>
                <Button
                    Height="{StaticResource BarKeyHeight}"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_nav_up"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE70E;" />
                </Button>
                <Button
                    Height="{StaticResource BarKeyHeight}"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_nav_right"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                </Button>
            </StackPanel>
        </Grid>


        <!--  panel bar  -->
        <!--
            a function that comes in a family gets a panel here rather than a key below; the keypad
            holds what a physical calculator prints on a key, this bar holds what one hides behind a
            menu, and it takes another button whenever the next family arrives
            the keys inside carry the same InputCommand as the pad, the Click handler only closes the
            panel behind them so it reads as a menu
        -->
        <StackPanel Grid.Row="3" Margin="0,0,0,4">

            <!--
                the negative sides cancel the pages own 4px inset, so the line reaches the window
                edge rather than stopping where the keys stop; it separates two bars and a bar runs
                the full width
            -->
            <Rectangle
                Height="1"
                Margin="-4,0,-4,4"
                HorizontalAlignment="Stretch"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                RadiusX="0.5"
                RadiusY="0.5" />

            <StackPanel Orientation="Horizontal" Spacing="4">

                <Button Height="{StaticResource BarKeyHeight}" Style="{StaticResource SubtleBarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Trigonometry" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="10"
                            Glyph="&#xE70D;" />
                    </StackPanel>

                    <Button.Flyout>
                        <!--
                            Bottom drops the panel over the keypad, which is the room there is;
                            ShouldConstrainToRootBounds lets it hang out of the window instead of
                            being squeezed back inside, which at the minimum window size is the
                            difference between three keys per row and one
                        -->
                        <Flyout
                            x:Name="TrigonometryFlyout"
                            AreOpenCloseAnimationsEnabled="False"
                            Closed="TrigonometryFlyout_Closed"
                            Placement="Bottom"
                            ShouldConstrainToRootBounds="False">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <!--
                                two latches on the left and four grids of the same six keys on the
                                right, of which exactly one is ever visible; six slots times four
                                layers is the whole trigonometric family in one panel
                            -->
                            <Grid ColumnSpacing="2.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  a latch is two buttons in one cell, the same way the shift key on the pad is built  -->
                                <Grid Grid.Column="0" RowSpacing="2.5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Row="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_trig_inv"
                                        Style="{StaticResource OperatorButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsTrigInverseUnlatched, Mode=OneWay}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Inv" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_trig_inv"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsTrigInverseLatched, Mode=OneWay}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Inv" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_trig_hyp"
                                        Style="{StaticResource OperatorButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsTrigHyperbolicUnlatched, Mode=OneWay}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="hyp" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_trig_hyp"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsTrigHyperbolicLatched, Mode=OneWay}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="hyp" />
                                    </Button>
                                </Grid>

                                <!--  plain  -->
                                <Grid
                                    Grid.Column="1"
                                    ColumnSpacing="2.5"
                                    RowSpacing="2.5"
                                    Visibility="{x:Bind ViewModel.ShowTrigPlain, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_sin"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sin" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_cos"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cos" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_tan"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tan" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_sec"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sec" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_csc"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csc" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_cot"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cot" />
                                    </Button>
                                </Grid>

                                <!--  inverse  -->
                                <Grid
                                    Grid.Column="1"
                                    ColumnSpacing="2.5"
                                    RowSpacing="2.5"
                                    Visibility="{x:Bind ViewModel.ShowTrigInverse, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_asin"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sin⁻¹" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_acos"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cos⁻¹" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_atan"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tan⁻¹" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_asec"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sec⁻¹" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_acsc"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csc⁻¹" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_acot"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cot⁻¹" />
                                    </Button>
                                </Grid>

                                <!--  hyperbolic  -->
                                <Grid
                                    Grid.Column="1"
                                    ColumnSpacing="2.5"
                                    RowSpacing="2.5"
                                    Visibility="{x:Bind ViewModel.ShowTrigHyperbolic, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_sinh"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sinh" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_cosh"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cosh" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_tanh"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tanh" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_sech"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sech" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_csch"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csch" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_coth"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="coth" />
                                    </Button>
                                </Grid>

                                <!--  inverse hyperbolic  -->
                                <Grid
                                    Grid.Column="1"
                                    ColumnSpacing="2.5"
                                    RowSpacing="2.5"
                                    Visibility="{x:Bind ViewModel.ShowTrigInverseHyperbolic, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_asinh"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sinh⁻¹" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_acosh"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cosh⁻¹" />
                                    </Button>
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_atanh"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tanh⁻¹" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_asech"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sech⁻¹" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_acsch"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csch⁻¹" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Width="{StaticResource PanelKeyWidth}"
                                        Height="{StaticResource PanelKeyHeight}"
                                        Click="FlyoutKey_Click"
                                        Command="{x:Bind ViewModel.InputCommand}"
                                        CommandParameter="cmd_acoth"
                                        Style="{StaticResource NumberPadButtonStyle}">
                                        <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="coth⁻¹" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button Height="{StaticResource BarKeyHeight}" Style="{StaticResource SubtleBarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="Function" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="10"
                            Glyph="&#xE70D;" />
                    </StackPanel>

                    <Button.Flyout>
                        <Flyout
                            x:Name="FunctionFlyout"
                            AreOpenCloseAnimationsEnabled="False"
                            Placement="Bottom"
                            ShouldConstrainToRootBounds="False">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <!--  one layer, no latch: none of these six comes in a family  -->
                            <Grid ColumnSpacing="2.5" RowSpacing="2.5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Width="{StaticResource PanelKeyWidth}"
                                    Height="{StaticResource PanelKeyHeight}"
                                    Click="FlyoutKey_Click"
                                    Command="{x:Bind ViewModel.InputCommand}"
                                    CommandParameter="cmd_abs"
                                    Style="{StaticResource NumberPadButtonStyle}">
                                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="|x|" />
                                </Button>
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="{StaticResource PanelKeyWidth}"
                                    Height="{StaticResource PanelKeyHeight}"
                                    Click="FlyoutKey_Click"
                                    Command="{x:Bind ViewModel.InputCommand}"
                                    CommandParameter="cmd_floor"
                                    Style="{StaticResource NumberPadButtonStyle}">
                                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="⌊x⌋" />
                                </Button>
                                <Button
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Width="{StaticResource PanelKeyWidth}"
                                    Height="{StaticResource PanelKeyHeight}"
                                    Click="FlyoutKey_Click"
                                    Command="{x:Bind ViewModel.InputCommand}"
                                    CommandParameter="cmd_ceil"
                                    Style="{StaticResource NumberPadButtonStyle}">
                                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="⌈x⌉" />
                                </Button>
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="{StaticResource PanelKeyWidth}"
                                    Height="{StaticResource PanelKeyHeight}"
                                    Click="FlyoutKey_Click"
                                    Command="{x:Bind ViewModel.InputCommand}"
                                    CommandParameter="cmd_rand"
                                    Style="{StaticResource NumberPadButtonStyle}">
                                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="rand" />
                                </Button>
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="{StaticResource PanelKeyWidth}"
                                    Height="{StaticResource PanelKeyHeight}"
                                    Click="FlyoutKey_Click"
                                    Command="{x:Bind ViewModel.InputCommand}"
                                    CommandParameter="cmd_dms"
                                    Style="{StaticResource NumberPadButtonStyle}">
                                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="dms" />
                                </Button>
                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Width="{StaticResource PanelKeyWidth}"
                                    Height="{StaticResource PanelKeyHeight}"
                                    Click="FlyoutKey_Click"
                                    Command="{x:Bind ViewModel.InputCommand}"
                                    CommandParameter="cmd_degrees"
                                    Style="{StaticResource NumberPadButtonStyle}">
                                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="deg" />
                                </Button>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </StackPanel>


        <!--  keypad  -->
        <!--
            every key binds to the same InputCommand and identifies itself through its
            CommandParameter, so the page carries no input logic at all
            A shiftable key is two buttons in the same cell whose Visibility is driven by
            NormalVisibility / ShiftVisibility, one of which is always collapsed
        -->
        <Grid
            Grid.Row="4"
            ColumnSpacing="2.5"
            RowSpacing="2.5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  row 0  -->
            <Button
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_shift"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE752;" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_shift"
                Style="{ThemeResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE752;" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_frac"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                <!--
                    the key is drawn as the stacked fraction it inserts instead of being written on
                    one line, so it shows the shape that ends up on the display
                    both halves sit at the script size the display sets a numerator in, and tight
                    line bounds drop the leading around them, which is what keeps the stack inside a
                    key; the bar reaches past them on either side the way the display draws it
                -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="2,0,2,2"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Text="x"
                        TextLineBounds="Tight" />
                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="2,2,2,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Text="y"
                        TextLineBounds="Tight" />
                </Grid>
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_frac_mixed"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                <!--  the same stack with the whole part in front of it, which is the shape a mixed fraction has  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="2">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="x"
                        TextLineBounds="Tight" />
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="2,0,2,2"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="y"
                            TextLineBounds="Tight" />
                        <Rectangle
                            Grid.Row="1"
                            Height="1"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            Grid.Row="2"
                            Margin="2,2,2,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Text="z"
                            TextLineBounds="Tight" />
                    </Grid>
                </StackPanel>
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_sqrt"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="²√" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_root_n"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="ⁿ√" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_pow_2"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="x²" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_pow_n"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="xⁿ" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_ln"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="ln" />
            </Button>
            <Button
                Grid.Row="0"
                Grid.Column="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_pow_e"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="eⁿ" />
            </Button>

            <!--  row 1  -->
            <Button
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_inv"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="x⁻¹" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_fact"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="x!" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_log"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="log" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_log_b"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="logₙ" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_ans"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Ans" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_percent"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="%" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_paren_open"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="(" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_e"
                Style="{StaticResource OperatorButtonStyle}"
                Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="e" />
            </Button>
            <Button
                Grid.Row="1"
                Grid.Column="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_paren_close"
                Style="{StaticResource OperatorButtonStyle}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text=")" />
            </Button>

            <!--  row 2  -->
            <Button
                Grid.Row="2"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="7"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="7" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="8"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="8" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="9"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="9" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.BackspaceCommand}"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="16" Glyph="&#xE750;" />
            </Button>
            <Button
                Grid.Row="2"
                Grid.Column="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.ClearCommand}"
                Style="{StaticResource OperatorButtonStyle}">
                <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="AC" />
            </Button>

            <!--  row 3  -->
            <Button
                Grid.Row="3"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="4"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="4" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="5"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="5" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="6"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="6" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="*"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE947;" />
            </Button>
            <Button
                Grid.Row="3"
                Grid.Column="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="/"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE94A;" />
            </Button>

            <!--  row 4  -->
            <Button
                Grid.Row="4"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="1"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="1" />
            </Button>
            <Button
                Grid.Row="4"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="2"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="2" />
            </Button>
            <Button
                Grid.Row="4"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="3"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="3" />
            </Button>
            <Button
                Grid.Row="4"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="+"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE948;" />
            </Button>
            <Button
                Grid.Row="4"
                Grid.Column="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="-"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE949;" />
            </Button>

            <!--  row 5  -->
            <Button
                Grid.Row="5"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="0"
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="0" />
            </Button>
            <Button
                Grid.Row="5"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="."
                Style="{StaticResource NumberPadButtonStyle}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="." />
            </Button>
            <Button
                Grid.Row="5"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_exp"
                Style="{StaticResource NumberPadButtonStyle}"
                Visibility="{x:Bind ViewModel.IsNormalLayer, Mode=OneWay}">
                <!--  the multiplication sign is the one the display prints, not the asterisk it is typed as  -->
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="×10ⁿ" />
            </Button>
            <Button
                Grid.Row="5"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.InputCommand}"
                CommandParameter="cmd_pi"
                Style="{StaticResource NumberPadButtonStyle}"
                Visibility="{x:Bind ViewModel.IsShiftLayer, Mode=OneWay}">
                <TextBlock Style="{ThemeResource BodyLargeTextBlockStyle}" Text="π" />
            </Button>
            <Button
                Grid.Row="5"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.ToggleAnswerFormCommand}"
                Style="{StaticResource OperatorButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE8AB;" />
            </Button>
            <Button
                Grid.Row="5"
                Grid.Column="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{x:Bind ViewModel.CalculateCommand}"
                Style="{ThemeResource AccentButtonStyle}">
                <FontIcon
                    FontSize="14"
                    FontWeight="Bold"
                    Glyph="&#xE94E;" />
            </Button>
        </Grid>

    </Grid>
</Page>
