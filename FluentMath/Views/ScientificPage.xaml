<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentMath.Views.ScientificPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentMath.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentMath.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <!--
        four rows: header, display, divider, pad; the pad is the panel bar over the keypad
        the caret bar moved into the display block and the divider has a row of its own, which leaves
        the two halves of the page as the star rows either side of it; a splitter laid over the
        divider trades height between them, and since only a star sized row inside either half can
        grow, neither bar ever changes height
        a MinHeight on each star row is the whole travel limit: the two always add up to the same
        number, so a floor under one is the ceiling over the other
    -->
    <Grid Margin="4,4,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4*" MinHeight="96" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" MinHeight="252" />
        </Grid.RowDefinitions>


        <!--  page header  -->
        <!--  (the left margin clears the navigation views hamburger button)  -->
        <Grid
            Grid.Row="0"
            Height="38"
            Margin="45,0,0,0"
            Background="Transparent">
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="8">

                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Scientific" />

                <!--  planned: compact mode toggle  -->
                <!--<Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Style="{ThemeResource SubtleButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE81C;" />
                </Button>-->
            </StackPanel>

            <!--  history and memory  -->
            <!--
                both open a panel of their own once there is something to put in it; the keys are
                here now because the header is laid out around them, and disabled until then
                history carries the Segoe glyph the Windows Calculator uses for the same button
                memory carries the Segoe library glyph rather than the M a calculator prints: M is
                one register on a physical calculator, MR and M plus and M minus, and this opens a
                named and categorised store of formulas, which is a collection and not a register
            -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_history"
                    IsEnabled="False"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE81C;" />
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_memory"
                    IsEnabled="False"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE8F1;" />
                </Button>
            </StackPanel>
        </Grid>


        <!--  calculator display  -->
        <!--
            both lines are one CalculatorDisplay
            the caret bar is the second row of this block rather than a band of its own; the splitter
            resizes the block as a whole, so a bar that has to keep its height belongs in an Auto row
            inside it
        -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:CalculatorDisplay
                x:Name="Display"
                Grid.Row="0"
                ViewModel="{x:Bind ViewModel}" />

            <!--  caret bar  -->
            <!--
                the arrow keys move the caret rather than write anything, so they sit with the display
                instead of on the pad; the angle unit rides along because it is the other thing that is a
                mode and not an input, and its button shows the unit it is currently in
                the two groups are pushed to opposite edges and the keys are a fixed size rather than a
                share of the width, so neither group reflows as the window is resized
                the keys are flat, like the panel buttons below them, and both bars run at the same key
                height: everything above the divider is read from or switched, and the raised fill below
                it is what marks a key that writes something
            -->
            <Grid Grid.Row="1" Height="{StaticResource BarKeyHeight}">

                <Button
                    Height="{StaticResource BarKeyHeight}"
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.InputCommand}"
                    CommandParameter="cmd_angle_cycle"
                    Style="{StaticResource SubtleBarButtonStyle}">
                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.AngleModeLabel, Mode=OneWay}" />
                </Button>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="{StaticResource KeySpacing}">

                    <Button
                        Height="{StaticResource BarKeyHeight}"
                        Command="{x:Bind ViewModel.InputCommand}"
                        CommandParameter="cmd_nav_down"
                        Style="{StaticResource SubtleBarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE70D;" />
                    </Button>
                    <Button
                        Height="{StaticResource BarKeyHeight}"
                        Command="{x:Bind ViewModel.InputCommand}"
                        CommandParameter="cmd_nav_up"
                        Style="{StaticResource SubtleBarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE70E;" />
                    </Button>
                    <Button
                        Height="{StaticResource BarKeyHeight}"
                        Command="{x:Bind ViewModel.InputCommand}"
                        CommandParameter="cmd_nav_left"
                        Style="{StaticResource SubtleBarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE76B;" />
                    </Button>
                    <Button
                        Height="{StaticResource BarKeyHeight}"
                        Command="{x:Bind ViewModel.InputCommand}"
                        CommandParameter="cmd_nav_right"
                        Style="{StaticResource SubtleBarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE76C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>


        <!--  divider  -->
        <!--
            the negative sides cancel the pages own 4px inset, so the line reaches the window
            edge rather than stopping where the keys stop; it separates two bars and a bar runs
            the full width
            the 4px above the line used to hang under the caret bar; it moved here so the line
            sits in the middle of the 9px band the splitter takes hold of
        -->
        <Rectangle
            Grid.Row="2"
            Height="1"
            Margin="-4,4,-4,4"
            HorizontalAlignment="Stretch"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
            RadiusX="0.5"
            RadiusY="0.5" />


        <!--  divider grab  -->
        <!--
            laid over the divider row, which is the 4px, the divider line and the 4px under it; it
            is transparent until the pointer reaches it, so the band goes on looking like the line
            it covers
            PreviousAndNext is what makes it trade the display row against the pad row rather than
            resize the row it stands in, and the MinHeight on those two rows is how far it
            goes; a Toolkit sizer also carries the resize cursor, the keyboard arrows and an
            automation peer, none of which a Rectangle with a manipulation handler would
        -->
        <toolkit:GridSplitter
            Grid.Row="2"
            Height="9"
            Margin="-4,0,-4,0"
            Padding="0"
            VerticalAlignment="Top"
            IsThumbVisible="False"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Rows" />


        <!--  pad  -->
        <!--
            everything under the divider in one block, the panel bar over the keypad; it grows in as a
            whole when the page is shown, see PadEntrance
        -->
        <Grid x:Name="Pad" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  panel bar  -->
            <!--
                a function that comes in a family gets a panel here rather than a key below; the keypad
                holds what a physical calculator prints on a key, this bar holds what one hides behind a
                menu, and it takes another button whenever the next family arrives
                every panel picks the grid its own keys want, two by one up to six by two; what they share
                is the key size and KeySpacing, which is what makes them read as one set
                the keys inside carry the same InputCommand as the pad, the Click handler only closes the
                panel behind them so it reads as a menu
                the bar takes a button per family and there is no window width at which they all
                fit, so it scrolls sideways rather than clipping the last one; no scrollbar, the row
                is short and a wheel or a chevron is how it is reached
            -->
            <ScrollViewer
                x:Name="PanelScroller"
                Grid.Row="0"
                Margin="0,0,0,4"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Auto"
                Loaded="PanelScroller_Loaded"
                SizeChanged="PanelScroller_SizeChanged"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ViewChanged="PanelScroller_ViewChanged">
                <StackPanel
                    x:Name="PanelStrip"
                    Orientation="Horizontal"
                    Spacing="4">

                    <Button Height="{StaticResource BarKeyHeight}" Style="{StaticResource SubtleBarButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Trigonometry" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="10"
                                Glyph="&#xE70D;" />
                        </StackPanel>

                        <Button.Flyout>
                            <!--
                                Bottom drops the panel over the keypad, which is the room there is;
                                ShouldConstrainToRootBounds lets it hang out of the window instead of
                                being squeezed back inside, which at the minimum window size is the
                                difference between three keys per row and one
                            -->
                            <Flyout
                                x:Name="TrigonometryFlyout"
                                AreOpenCloseAnimationsEnabled="False"
                                Closed="TrigonometryFlyout_Closed"
                                Placement="Bottom"
                                ShouldConstrainToRootBounds="False">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="{StaticResource PanelFlyoutOffset}" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <!--
                                    two latches on the left and four grids of the same six keys on the
                                    right, of which exactly one is ever visible; six slots times four
                                    layers is the whole trigonometric family in one panel
                                -->
                                <Grid ColumnSpacing="{StaticResource KeySpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  a latch is two buttons in one cell, the same way the shift key on the pad is built  -->
                                    <Grid Grid.Column="0" RowSpacing="{StaticResource KeySpacing}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_trig_inv"
                                            Style="{StaticResource OperatorButtonStyle}"
                                            Visibility="{x:Bind ViewModel.IsTrigInverseUnlatched, Mode=OneWay}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Inv" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_trig_inv"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Visibility="{x:Bind ViewModel.IsTrigInverseLatched, Mode=OneWay}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Inv" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_trig_hyp"
                                            Style="{StaticResource OperatorButtonStyle}"
                                            Visibility="{x:Bind ViewModel.IsTrigHyperbolicUnlatched, Mode=OneWay}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="hyp" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_trig_hyp"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Visibility="{x:Bind ViewModel.IsTrigHyperbolicLatched, Mode=OneWay}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="hyp" />
                                        </Button>
                                    </Grid>

                                    <!--  plain  -->
                                    <Grid
                                        Grid.Column="1"
                                        ColumnSpacing="{StaticResource KeySpacing}"
                                        RowSpacing="{StaticResource KeySpacing}"
                                        Visibility="{x:Bind ViewModel.ShowTrigPlain, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_sin"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sin" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_cos"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cos" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_tan"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tan" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_sec"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sec" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_csc"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csc" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_cot"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cot" />
                                        </Button>
                                    </Grid>

                                    <!--  inverse  -->
                                    <Grid
                                        Grid.Column="1"
                                        ColumnSpacing="{StaticResource KeySpacing}"
                                        RowSpacing="{StaticResource KeySpacing}"
                                        Visibility="{x:Bind ViewModel.ShowTrigInverse, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_asin"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sin⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acos"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cos⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_atan"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tan⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_asec"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sec⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acsc"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csc⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acot"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cot⁻¹" />
                                        </Button>
                                    </Grid>

                                    <!--  hyperbolic  -->
                                    <Grid
                                        Grid.Column="1"
                                        ColumnSpacing="{StaticResource KeySpacing}"
                                        RowSpacing="{StaticResource KeySpacing}"
                                        Visibility="{x:Bind ViewModel.ShowTrigHyperbolic, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_sinh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sinh" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_cosh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cosh" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_tanh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tanh" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_sech"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sech" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_csch"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csch" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_coth"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="coth" />
                                        </Button>
                                    </Grid>

                                    <!--  inverse hyperbolic  -->
                                    <Grid
                                        Grid.Column="1"
                                        ColumnSpacing="{StaticResource KeySpacing}"
                                        RowSpacing="{StaticResource KeySpacing}"
                                        Visibility="{x:Bind ViewModel.ShowTrigInverseHyperbolic, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_asinh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sinh⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acosh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="cosh⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_atanh"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="tanh⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_asech"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="sech⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acsch"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="csch⁻¹" />
                                        </Button>
                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="{StaticResource PanelKeyWidth}"
                                            Height="{StaticResource PanelKeyHeight}"
                                            Click="FlyoutKey_Click"
                                            Command="{x:Bind ViewModel.InputCommand}"
                                            CommandParameter="cmd_acoth"
                                            Style="{StaticResource NumberPadButtonStyle}">
                                            <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="coth⁻¹" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Height="{StaticResource BarKeyHeight}" Style="{StaticResource SubtleBarButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="Function" />
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="10"
                                Glyph="&#xE70D;" />
                        </StackPanel>

                        <Button.Flyout>
                            <Flyout
                                x:Name="FunctionFlyout"
                                AreOpenCloseAnimationsEnabled="False"
                                Placement="Bottom"
