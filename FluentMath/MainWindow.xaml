<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FluentMath.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentMath"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Fluent Math"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  custom title bar  -->
        <!--  (the window extends its content into the caption area, so the bar is drawn here)  -->
        <TitleBar
            Title="Fluent Math"
            Grid.Row="0"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Icon/Icon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  navigation view  -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            ItemInvoked="NavView_ItemInvoked"
            OpenPaneLength="200"
            PaneDisplayMode="LeftMinimal">

            <!--
                the content area of a navigation view paints LayerFillColorDefaultBrush behind the
                frame, which lifts the base from the #202020 Mica tint to #282828 and in light from
                #F3F3F3 to #F9F9F9; both brushes go transparent so the pages sit on the bare backdrop
                the keypad colors in App.xaml are calibrated against
                the second one is the 1px line the view draws above its content, which the frame used
                to hide behind a negative top margin
                they sit on the control and not in the app theme dictionaries because a key put here
                is found before anything merged from XamlControlsResources
            -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>

            <!--  menu items: the calculators and the converters, each group under a header  -->
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Calculator" />

                <NavigationViewItem Content="Standard" Tag="Standard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--
                    the flask the Windows Calculator gives its scientific mode; the glyph is in Segoe
                    Fluent Icons only, so Windows 10 draws nothing here
                -->
                <NavigationViewItem Content="Scientific" Tag="Scientific">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF196;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Converter" />

                <!--
                    the three coins the Windows Calculator gives its currency converter; no Windows icon
                    font has them, only the Windows Calculators own one does (EB0D, MIT licensed), so the
                    outline is copied here as a path in the 16 by 16 box a FontIcon draws into
                    the explicit size keeps the icon box from scaling the path up to fill it with ink
