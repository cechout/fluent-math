<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Calculator_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Calculator_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Calculator"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  custom title bar  -->
        <!--  (the window extends its content into the caption area, so the bar is drawn here)  -->
        <TitleBar
            Title="Simple Calculator"
            Grid.Row="0"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Icon/Icon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  navigation view  -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            ItemInvoked="NavView_ItemInvoked"
            OpenPaneLength="200"
            PaneDisplayMode="LeftMinimal">

            <!--
                the content area of a navigation view paints LayerFillColorDefaultBrush behind the
                frame, which lifts the base from the #202020 Mica tint to #282828 and in light from
                #F3F3F3 to #F9F9F9; both brushes go transparent so the pages sit on the bare backdrop
                the keypad colors in App.xaml are calibrated against
                the second one is the 1px line the view draws above its content, which the frame used
                to hide behind a negative top margin
                they sit on the control and not in the app theme dictionaries because a key put here
                is found before anything merged from XamlControlsResources
            -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Standard" Tag="Standard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Currency" Tag="Currency">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE825;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="MainFrame" />
        </NavigationView>
    </Grid>

</Window>