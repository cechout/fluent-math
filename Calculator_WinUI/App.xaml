<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Calculator_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator_WinUI">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                every fill and every border is alpha over the Mica backdrop, so a key tracks whatever
                shows through instead of pinning a color
                base is the Mica tint, #F3F3F3 in light and #202020 in dark
                white on a dark base is alpha = 255 * (target - base) / (255 - base)
                black on a light base is alpha = 255 * (base - target) / base
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">

                    <!--  === fill colors ===  -->
                    <!--  number pad  -->
                    <SolidColorBrush x:Key="NumPadNormal" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="NumPadHover" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="NumPadPressed" Color="#0AFFFFFF" />

                    <!--  operator button  -->
                    <SolidColorBrush x:Key="OpNormal" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="OpHover" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="OpPressed" Color="#14FFFFFF" />

                    <!--  === border colors ===  -->
                    <!--  number pad  -->
                    <LinearGradientBrush x:Key="NumPadBorder" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.7" Color="#25FFFFFF" />
                        <GradientStop Offset="1.0" Color="#14FFFFFF" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="NumPadBorderPressed" Color="#14FFFFFF" />

                    <!--  operator button  -->
                    <LinearGradientBrush x:Key="OpBorder" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.7" Color="#1CFFFFFF" />
                        <GradientStop Offset="1.0" Color="#17FFFFFF" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="OpBorderPressed" Color="#1CFFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">

                    <!--  === fill colors ===  -->
                    <!--  number pad  -->
                    <!--
                        NumPadNormal and OpHover aim at #FCFCFC and not at the #FFFFFF they used to
                        be: pure white over a base of 243 needs alpha 255 and would stop tracking the
                        backdrop, and three levels buy the translucency back
                    -->
                    <SolidColorBrush x:Key="NumPadNormal" Color="#BFFFFFFF" />
                    <SolidColorBrush x:Key="NumPadHover" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="NumPadPressed" Color="#40FFFFFF" />

                    <!--  operator button  -->
                    <SolidColorBrush x:Key="OpNormal" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="OpHover" Color="#BFFFFFFF" />
                    <SolidColorBrush x:Key="OpPressed" Color="#80FFFFFF" />

                    <!--  === border colors ===  -->
                    <!--  number pad  -->
                    <!--  (both stops land on ControlStrokeColorDefault and ControlStrokeColorSecondary)  -->
                    <LinearGradientBrush x:Key="NumPadBorder" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.7" Color="#0F000000" />
                        <GradientStop Offset="1.0" Color="#29000000" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="NumPadBorderPressed" Color="#0F000000" />

                    <!--  operator button  -->
                    <LinearGradientBrush x:Key="OpBorder" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.7" Color="#16000000" />
                        <GradientStop Offset="1.0" Color="#33000000" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="OpBorderPressed" Color="#16000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  number pad key  -->
            <!--  brighter fill, used for digits and the decimal point  -->
            <Style x:Key="NumberPadButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource NumPadNormal}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />

                <Setter Property="BorderBrush" Value="{ThemeResource NumPadBorder}" />
                <Setter Property="BorderThickness" Value="1,1,1,1" />
                <Setter Property="CornerRadius" Value="4" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid
                                x:Name="RootGrid"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NumPadHover}" />
                                                </ObjectAnimationUsingKeyFrames>

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OpBorder}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NumPadPressed}" />
                                                </ObjectAnimationUsingKeyFrames>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="ContentPresenter"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.7"
                                                    Duration="0" />

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource NumPadBorderPressed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  operator key  -->
            <!--  quieter fill, used for everything that is not a digit  -->
            <Style x:Key="OperatorButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource OpNormal}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />

                <Setter Property="BorderBrush" Value="{ThemeResource OpBorder}" />
                <Setter Property="BorderThickness" Value="1,1,1,1" />
                <Setter Property="CornerRadius" Value="4" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid
                                x:Name="RootGrid"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OpHover}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OpPressed}" />
                                                </ObjectAnimationUsingKeyFrames>

                                                <DoubleAnimation
                                                    Storyboard.TargetName="ContentPresenter"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.7"
                                                    Duration="0" />

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource OpBorderPressed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  bar key height  -->
            <!--
                the caret bar and the panel bar carry the same key height, so the two read as one
                block between the display and the pad; it is one number rather than two so they
                cannot drift apart
            -->
            <x:Double x:Key="BarKeyHeight">32</x:Double>

            <!--  key spacing  -->
            <!--
                the one gap between two keys, on the pad and inside every panel alike; a panel is
                meant to read as a piece of the pad that happens to float, and that only holds while
                the two are spaced the same
            -->
            <x:Double x:Key="KeySpacing">2.5</x:Double>

            <!--  panel key size  -->
            <!--
                a panel key runs the keypad styles, which carry no size because a key on the pad takes
                the star sized cell it sits in; a panel grid has no such cell, so every key in a panel
                carries these two instead
                they sit on the key and not on the Row and ColumnDefinitions, because those take a
                GridLength and a Double resource cannot be assigned to one; that mistake builds clean
                and throws a XamlParseException the first time the page is loaded
            -->
            <x:Double x:Key="PanelKeyWidth">56</x:Double>
            <x:Double x:Key="PanelKeyHeight">40</x:Double>

            <!--  subtle button  -->
            <!--
                the platform SubtleButtonStyle fades its fill in over 83 ms but swaps the border
                brush in the frame the state changes, and both resolve to the same brush; a hover
                therefore starts as a 1px outline in the final color around a still empty button
                every state brush below is the one the platform style uses, the border just stays
                transparent in all of them, and the fill is sized to the outer border edge so it
                still covers the full box
            -->
            <Style x:Key="SubtleBarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleButtonBackground}" />
                <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleButtonForeground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource ButtonBorderThemeThickness}" />
                <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
                <!--  the style carries its own template and no BasedOn, so the two content alignments the platform button relies on are set here rather than inherited  -->
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
                <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
                <Setter Property="FocusVisualMargin" Value="-3" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />

                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                Background="{TemplateBinding Background}"
                                BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Foreground="{TemplateBinding Foreground}">

                                <!--  the value of ControlFasterAnimationDuration  -->
                                <!--
                                    (spelled out because BrushTransition.Duration is a TimeSpan and
                                    the platform keys are strings; the platform button hardcodes it
                                    the same way)
                                -->
                                <ContentPresenter.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083" />
                                </ContentPresenter.BackgroundTransition>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">

                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonBackgroundPointerOver}" />
                                                </ObjectAnimationUsingKeyFrames>

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonForegroundPointerOver}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonBackgroundPressed}" />
                                                </ObjectAnimationUsingKeyFrames>

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonForegroundPressed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonBackgroundDisabled}" />
                                                </ObjectAnimationUsingKeyFrames>

                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleButtonForegroundDisabled}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                    </VisualStateGroup>

                                    <!--
                                        a Button raises no visual state for the flyout it carries
                                        being open; the platform only tracks it for automation, and
                                        DropDownButton does the same and no more, so a bar button is
                                        told by the page that opened it
                                        it is a group of its own and not a state in CommonStates,
                                        because the pointer states go on being driven by the button
                                        underneath; an open flyout takes the pointer with it, so the
                                        two never reach for the foreground in the same frame
                                        every bar button carries the group and only the ones with a
                                        panel ever enter it, which is cheaper than a second copy of
                                        the whole style
                                    -->
                                    <VisualStateGroup x:Name="FlyoutStates">

                                        <VisualState x:Name="FlyoutClosed" />

                                        <VisualState x:Name="FlyoutOpen">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
