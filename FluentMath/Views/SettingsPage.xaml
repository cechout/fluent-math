<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentMath.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  (the page hides the header icons itself, all at one width, see UpdateHeaderIcons)  -->
        <x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
    </Page.Resources>

    <!--
        no page margin, so the cards scroll out at the window edge and the scroll bar sits on it
        (the header and the cards carry the 4 of the other pages themselves)
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  page header  -->
        <!--  (the left margin clears the navigation views hamburger button)  -->
        <Grid
            Grid.Row="0"
            Height="38"
            Margin="49,4,4,0"
            Background="Transparent">

            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                x:Name="CardsPanel"
                MaxWidth="1000"
                Margin="16,12,16,20"
                HorizontalAlignment="Stretch"
                SizeChanged="CardsPanel_SizeChanged"
                Spacing="4">

                <!--  general  -->
                <TextBlock
                    Margin="4,8,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="General" />

                <!--  app theme  -->
                <!--  (SettingsService keeps it, MainWindow applies it)  -->
                <controls:SettingsCard
                    Description="Light, dark, or match Windows"
                    Header="App Theme"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                    <ComboBox
                        x:Name="ThemeComboBox"
                        Width="150"
                        SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="System Default" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </controls:SettingsCard>

                <!--  start page  -->
                <!--  (in the order of StartupPage; the labels mirror the navigation entries)  -->
                <controls:SettingsCard
                    Description="The page the app opens on"
                    Header="Start Page"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE80F;}">
                    <ComboBox
                        x:Name="StartupPageComboBox"
                        Width="150"
                        SelectionChanged="StartupPageComboBox_SelectionChanged">
                        <ComboBoxItem Content="Standard" />
                        <ComboBoxItem Content="Scientific" />
                        <ComboBoxItem Content="Currency" />
                        <ComboBoxItem Content="Volume" />
                        <ComboBoxItem Content="Length" />
                    </ComboBox>
                </controls:SettingsCard>

                <!--  separators  -->
                <!--  (no header control, the two inside are independent; the icon is text, see TextIcon)  -->
                <controls:SettingsExpander
                    x:Name="SeparatorsExpander"
                    Description="The marks inside a number, in the calculators and the converters"
                    Header="Separators"
                    IsExpanded="False">

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Decimal Mark">
                            <ComboBox
                                x:Name="DecimalMarkComboBox"
                                Width="150"
                                SelectionChanged="CalculatorComboBox_SelectionChanged">
                                <ComboBoxItem Content="Windows region" />
                                <ComboBoxItem Content="Dot" />
                                <ComboBoxItem Content="Comma" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Digit Grouping">
                            <ToggleSwitch
                                x:Name="GroupDigitsToggle"
                                OffContent="Off"
                                OnContent="On"
                                Toggled="CalculatorToggle_Toggled" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>


                <!--  calculator  -->
                <TextBlock
                    Margin="4,20,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Calculator" />

                <!--  (App.Settings; every combo box lists its options in the order of their values)  -->

                <!--  angle unit  -->
                <controls:SettingsCard
                    Description="The unit sin, cos and tan read an angle in"
                    Header="Angle Unit"
                    HeaderIcon="{ui:FontIcon Glyph=&#xF0B4;}">
                    <ComboBox
                        x:Name="AngleUnitComboBox"
                        Width="150"
                        SelectionChanged="CalculatorComboBox_SelectionChanged">
                        <ComboBoxItem Content="Degrees" />
                        <ComboBoxItem Content="Radians" />
                        <ComboBoxItem Content="Gradians" />
                    </ComboBox>
                </controls:SettingsCard>

                <!--  result form  -->
                <!--  (the opening form in the header slot; the two inside pick the forms S⇔D goes through)  -->
                <controls:SettingsExpander
                    Description="The form a result opens in, and the forms S⇔D switches through"
                    Header="Result Form"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8AB;}"
                    IsExpanded="False">

                    <ComboBox
                        x:Name="ResultFormComboBox"
                        Width="150"
                        SelectionChanged="CalculatorComboBox_SelectionChanged">
                        <ComboBoxItem Content="Exact first" />
                        <ComboBoxItem Content="Decimal first" />
                    </ComboBox>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Fraction Form">
                            <ComboBox
                                x:Name="FractionFormComboBox"
                                Width="150"
                                SelectionChanged="CalculatorComboBox_SelectionChanged">
                                <ComboBoxItem Content="Improper" />
                                <ComboBoxItem Content="Mixed" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Recurring Decimals">
                            <ToggleSwitch
                                x:Name="RecurringToggle"
                                OffContent="Off"
                                OnContent="On"
                                Toggled="CalculatorToggle_Toggled" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  number format  -->
                <!--  (the notation in the header slot, the two inside refine it; the icon is text, see TextIcon)  -->
                <controls:SettingsExpander
                    x:Name="NumberFormatExpander"
                    Description="Norm 1 and Norm 2 write a power of ten below 0.01 and 1e-9, Fix and Sci a set number of digits"
                    Header="Number Format"
                    IsExpanded="False">

                    <ComboBox
                        x:Name="NotationComboBox"
                        Width="150"
                        SelectionChanged="CalculatorComboBox_SelectionChanged">
                        <ComboBoxItem Content="Norm 1" />
                        <ComboBoxItem Content="Norm 2" />
                        <ComboBoxItem Content="Fix" />
                        <ComboBoxItem Content="Sci" />
                    </ComboBox>

                    <controls:SettingsExpander.Items>
                        <!--  (stays disabled under Norm, see UpdateDigitsAvailability)  -->
                        <controls:SettingsCard x:Name="DigitsCard" Header="Digits">
                            <ComboBox
                                x:Name="DigitsComboBox"
                                Width="70"
                                SelectionChanged="CalculatorComboBox_SelectionChanged">
                                <ComboBoxItem Content="0" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="6" />
                                <ComboBoxItem Content="7" />
                                <ComboBoxItem Content="8" />
                                <ComboBoxItem Content="9" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Decimal Prefixes">
                            <ToggleSwitch
                                x:Name="PrefixesToggle"
                                OffContent="Off"
                                OnContent="On"
                                Toggled="CalculatorToggle_Toggled" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>


                <!--  converter  -->
                <TextBlock
                    Margin="4,20,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Converter" />

                <!--  precision  -->
                <!--
                    (no header control, the two inside are independent; the icon is text, see TextIcon)
                    (the items are filled from the ranges in ConverterSettings)
                -->
                <controls:SettingsExpander
                    x:Name="PrecisionExpander"
                    Description="How many digits a converted amount keeps"
                    Header="Precision"
                    IsExpanded="False">

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Description="Decimals of a money amount" Header="Currency Decimals">
                            <ComboBox
                                x:Name="CurrencyDecimalsComboBox"
                                Width="70"
                                SelectionChanged="ConverterComboBox_SelectionChanged" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Description="Significant digits of a measure" Header="Unit Digits">
                            <ComboBox
                                x:Name="UnitDigitsComboBox"
                                Width="70"
                                SelectionChanged="ConverterComboBox_SelectionChanged" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>


                <!--  backup and reset  -->
                <TextBlock
                    Margin="4,20,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Backup &amp; Reset" />

                <!--  app data folder  -->
                <!--  (the description becomes the real path, which differs per build)  -->
                <controls:SettingsCard
                    x:Name="AppDataFolderCard"
                    Description="Where settings, window and page state are stored"
                    Header="App Data Folder"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}">
                    <Button Click="OpenAppDataFolder_Click" Content="Open" />
                </controls:SettingsCard>

                <!--  export and import  -->
                <controls:SettingsCard
                    Description="Back up or restore all settings as a zip file (import restarts the app)"
                    Header="Export / Import Settings"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE74E;}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="ExportSettings_Click" Content="Export" />
                        <Button Click="ImportSettings_Click" Content="Import" />
                    </StackPanel>
                </controls:SettingsCard>

                <!--  reset  -->
                <!--  (everything in the header slot, one group per card inside)  -->
                <controls:SettingsExpander
                    Description="Restore the defaults (restarts the app)"
                    Header="Reset to Defaults"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE777;}"
                    IsExpanded="False">

                    <Button Click="ResetAll_Click" Content="Reset All" />

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Description="Theme, start page, separators, the calculator and the converter setup" Header="General Settings">
                            <Button Click="ResetGeneralSettings_Click" Content="Reset" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Description="Window position and size, compact sizes, display height and converter units" Header="Window and Page States">
                            <Button Click="ResetWindowAndPageStates_Click" Content="Reset" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>


                <!--  about and open source  -->
                <TextBlock
                    Margin="4,20,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="About &amp; Open Source" />

                <!--  app info  -->
                <!--  (the version in the header slot is read off the assembly, see VersionLabel)  -->
                <controls:SettingsExpander
                    Description="© 2026 Daniel Čech · MIT License"
                    Header="Fluent Math"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE946;}"
                    IsExpanded="False">

                    <TextBlock
                        x:Name="VersionTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True" />

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Documentation">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout/fluent-math" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Developer Profile">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/cechout" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  third-party libraries  -->
                <controls:SettingsExpander
                    Description="Open source projects used in this app"
                    Header="Third-Party Libraries"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE8F1;}"
                    IsExpanded="False">

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="Windows App SDK">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="Windows Community Toolkit">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/CommunityToolkit/Windows" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="WinUIEx">
                            <HyperlinkButton Content="GitHub" NavigateUri="https://github.com/dotMorten/WinUIEx" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!--  feedback  -->
                <!--  (opens the issue template picker)  -->
                <HyperlinkButton
                    Margin="0,4,0,8"
                    Content="Send Feedback"
                    NavigateUri="https://github.com/cechout/fluent-math/issues/new/choose" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
